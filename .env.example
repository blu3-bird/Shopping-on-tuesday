# Flask configuration
FLASK_CONFIG=development
SECRET_KEY=change-this-in-production

# Database (PostgreSQL - Neon or Supabase free tier)
# Format: postgresql+psycopg2://user:password@host:port/dbname
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/shopping_on_tuesday

# File uploads
UPLOAD_FOLDER=app/static/uploads
MAX_CONTENT_LENGTH=5242880

# Instagram (optional, for footer links)
INSTAGRAM_URL=https://instagram.com/your_handle
